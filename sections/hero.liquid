<section class="hero-card" id="Hero">
  <div class="hero-card__inner">
    {% if section.settings.background_image %}
      <img
        src="{{ section.settings.background_image | img_url: '2000x' }}"
        srcset="{{ section.settings.background_image | img_url: '800x' }} 800w,
                {{ section.settings.background_image | img_url: '1400x' }} 1400w,
                {{ section.settings.background_image | img_url: '2000x' }} 2000w"
        sizes="(max-width: 900px) 100vw, 90vw"
        alt="{{ section.settings.background_image.alt | escape }}"
        loading="eager"
        fetchpriority="high"
        class="hero-card__image"
      >
    {% else %}
      <div class="hero-card__image hero-card__image--placeholder"></div>
    {% endif %}

    <div class="hero-card__overlay"></div>

    <div class="hero-card__content">
      {%- comment -%}
        Brand lockup. The mark is cream on transparency, so it only works over
        the scrimmed left column (DESIGN_LANGUAGE §7) - never move it to the
        clear right side of the card.
      {%- endcomment -%}
      {% if section.settings.show_logo %}
        <img
          class="hero-card__logo"
          src="{{ section.settings.logo | default: 'Hasna-Logo-3-BG-Removed.png' | asset_url }}"
          alt="{{ shop.name }}"
          width="200"
          height="200"
          loading="eager"
          data-animate="fade"
        >
      {% endif %}

      {% if section.settings.eyebrow != blank %}
        <p class="hero-card__eyebrow" data-animate="fade">{{ section.settings.eyebrow }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1 class="hero-card__heading" data-animate="rise-lg">{{ section.settings.heading }}</h1>
      {% endif %}

      <div class="hero-card__actions" data-animate>
        {% if section.settings.button_label != blank %}
          <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="hero-card__btn">
            {{ section.settings.button_label }}
          </a>
        {% endif %}
        {% if section.settings.secondary_button_label != blank %}
          <a href="{{ section.settings.secondary_button_link | default: routes.root_url }}" class="hero-card__btn hero-card__btn--ghost">
            {{ section.settings.secondary_button_label }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    { "type": "checkbox", "id": "show_logo", "label": "Show logo in hero", "default": true },
    { "type": "image_picker", "id": "logo", "label": "Hero logo", "info": "Defaults to the theme logo asset. Must be light artwork: it sits on the dark side of the hero." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "Roasted in Austin · Sourced from Ethiopia" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Brewed Fresh,\nServed Warm." },
    { "type": "text", "id": "button_label", "label": "Primary button", "default": "Shop Coffee" },
    { "type": "url", "id": "button_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_button_label", "label": "Secondary button" },
    { "type": "url", "id": "secondary_button_link", "label": "Secondary button link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
