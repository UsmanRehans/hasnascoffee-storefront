<section class="hc-coll">
  <div class="container">

    {%- comment %} --- Page header ---
      Suppressed on templates that supply their own heading above this section
      (e.g. collection.beans), so the page keeps a single h1.
    {% endcomment %}
    <div class="hc-coll__header">
      {%- if section.settings.show_title == false -%}
      {%- elsif collection.image -%}
        <div class="hc-coll__hero">
          <img src="{{ collection.image | img_url: '2000x500', crop: 'center' }}" alt="{{ collection.title }}" loading="eager">
          <div class="hc-coll__hero-overlay">
            <h1 class="hc-coll__hero-title">{{ collection.title }}</h1>
            {%- if collection.description != blank -%}
              <p class="hc-coll__hero-desc">{{ collection.description }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- else -%}
        <div class="hc-coll__title-block">
          <h1 class="hc-coll__title">{{ collection.title }}</h1>
          {%- if collection.description != blank -%}
            <p class="hc-coll__desc">{{ collection.description }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="hc-coll__toolbar">
        <span class="hc-coll__count">{{ collection.products_count }} product{% if collection.products_count != 1 %}s{% endif %}</span>
        <div class="hc-coll__sort-wrap">
          <label for="HcSortBy" class="sr-only">Sort by</label>
          <select id="HcSortBy" class="hc-coll__sort" onchange="window.location.href = window.location.pathname + '?sort_by=' + this.value">
            <option value="manual"             {% if collection.sort_by == 'manual'             %}selected{% endif %}>Featured</option>
            <option value="best-selling"        {% if collection.sort_by == 'best-selling'        %}selected{% endif %}>Best Selling</option>
            <option value="title-ascending"     {% if collection.sort_by == 'title-ascending'     %}selected{% endif %}>A–Z</option>
            <option value="title-descending"    {% if collection.sort_by == 'title-descending'    %}selected{% endif %}>Z–A</option>
            <option value="price-ascending"     {% if collection.sort_by == 'price-ascending'     %}selected{% endif %}>Price: Low–High</option>
            <option value="price-descending"    {% if collection.sort_by == 'price-descending'    %}selected{% endif %}>Price: High–Low</option>
            <option value="created-descending"  {% if collection.sort_by == 'created-descending'  %}selected{% endif %}>Newest</option>
          </select>
        </div>
      </div>
    </div>

    {%- comment %} --- Product grid --- {% endcomment %}
    {%- if collection.products.size > 0 -%}
      {%- paginate collection.products by 16 -%}
        <div class="hc-coll__grid" data-animate-group>
          {%- for product in collection.products -%}
            {% render 'product-card', product: product %}
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <div class="hc-coll__pagination">
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}" class="hc-coll__pag-btn">← Previous</a>
            {%- endif -%}
            <span class="hc-coll__pag-info">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}" class="hc-coll__pag-btn">Next →</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endpaginate -%}
    {%- else -%}
      {%- comment -%}
        Empty state. A collection with nothing in it yet can still show what is
        coming, which is a better answer than "no products found". The artwork
        can come from Shopify Files (empty_image) or ship with the theme in
        assets/ (empty_image_asset) - the asset route is used for merch, whose
        mockups live in design/ alongside their print SVGs.
      {%- endcomment -%}
      {%- assign has_preview = false -%}
      {%- if section.settings.empty_image or section.settings.empty_image_asset != blank -%}
        {%- assign has_preview = true -%}
      {%- endif -%}

      <div class="hc-coll__empty{% if has_preview %} hc-coll__empty--preview{% endif %}">
        {%- if has_preview -%}
          <figure class="hc-coll__soon" data-animate>
            <div class="hc-coll__soon-frame">
              {%- if section.settings.empty_image -%}
                <img
                  src="{{ section.settings.empty_image | image_url: width: 1600 }}"
                  alt="{{ section.settings.empty_image.alt | escape | default: collection.title }}"
                  loading="eager"
                >
              {%- else -%}
                <img
                  src="{{ section.settings.empty_image_asset | asset_url }}"
                  alt="{{ section.settings.empty_alt | escape | default: collection.title }}"
                  loading="eager"
                >
              {%- endif -%}
            </div>

            <figcaption class="hc-coll__soon-caption">
              <p class="hc-coll__soon-label">{{ section.settings.empty_label | default: 'Coming soon' }}</p>
              {% render 'tilet-rule', width: '72px', class: 'hc-coll__soon-rule' %}
              {%- if section.settings.empty_text != blank -%}
                <p class="hc-coll__soon-text">{{ section.settings.empty_text }}</p>
              {%- endif -%}
            </figcaption>
          </figure>
        {%- else -%}
          <p>No products found in this collection yet.</p>
          <a href="{{ routes.root_url }}" class="btn btn--primary">Back to Home</a>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</section>

<style>
/* ------------------------------
   Collection Page
------------------------------ */
.hc-coll {
  padding: var(--space-12) 0 var(--space-20);
}

/* Hero banner */
.hc-coll__hero {
  position: relative;
  border-radius: var(--radius-xl);
  overflow: hidden;
  margin-bottom: var(--space-10);
  aspect-ratio: 5/1;
  min-height: 160px;
}
.hc-coll__hero img { width: 100%; height: 100%; object-fit: cover; }
.hc-coll__hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to right, rgba(26,12,5,0.88), rgba(26,12,5,0.2));
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: var(--space-12);
}
.hc-coll__hero-title {
  font-family: var(--font-display);
  font-size: var(--text-4xl);
  color: #F8F4EE;
  margin: 0 0 var(--space-2);
}
.hc-coll__hero-desc { color: rgba(248,244,238,0.75); font-size: var(--text-lg); margin: 0; }

/* No-image title */
.hc-coll__title-block { margin-bottom: var(--space-8); }
.hc-coll__title {
  font-family: var(--font-display);
  font-size: var(--text-4xl);
  color: var(--color-text);
  margin: 0 0 var(--space-3);
}
.hc-coll__desc { color: var(--color-text-secondary); font-size: var(--text-lg); }

/* Toolbar */
.hc-coll__toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-8);
  padding-bottom: var(--space-5);
  border-bottom: 1px solid var(--color-border);
}
.hc-coll__count { font-size: var(--text-sm); color: var(--color-text-muted); }
.hc-coll__sort {
  background: var(--color-text);
  border: 1px solid rgba(248,244,238,0.12);
  color: #F8F4EE;
  padding: var(--space-2) var(--space-5) var(--space-2) var(--space-3);
  border-radius: var(--radius-md);
  font-size: var(--text-sm);
  cursor: pointer;
  outline: none;
  transition: border-color 0.2s;
}
.hc-coll__sort:focus { border-color: var(--color-gold); }
.hc-coll__sort option { background: var(--color-text); color: #F8F4EE; }

/* Grid - matches the bento reference: 4-up on large, 2-up on mobile */
.hc-coll__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--gap-grid);
  /* Cards carry their own 28px top padding, which already clears the -18px
     float on cutout images. Extra grid padding here was pure dead space. */
  padding-top: 0;
}

@media (max-width: 1100px) {
  .hc-coll__grid { grid-template-columns: repeat(3, 1fr); }
}
@media (max-width: 768px) {
  .hc-coll__grid { grid-template-columns: repeat(2, 1fr); gap: var(--gap-grid-sm); }
}
@media (max-width: 460px) {
  .hc-coll__grid { grid-template-columns: 1fr; }
}

/* Pagination */
.hc-coll__pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-6);
  margin-top: var(--space-16);
}
.hc-coll__pag-btn {
  background: var(--color-text);
  color: #F8F4EE;
  padding: 10px 24px;
  border-radius: 8px;
  text-decoration: none;
  font-size: var(--text-sm);
  font-weight: 600;
  transition: background 0.2s;
}
.hc-coll__pag-btn:hover { background: var(--color-gold); color: var(--color-text); }
.hc-coll__pag-info { color: var(--color-text-muted); font-size: var(--text-sm); }

/* Empty */
.hc-coll__empty { text-align: center; padding: var(--space-20) 0; }
.hc-coll__empty p { color: var(--color-text-muted); margin-bottom: var(--space-6); font-size: var(--text-lg); }

/* Empty state with preview artwork */
.hc-coll__empty--preview { padding: var(--space-12) 0 var(--space-16); }

.hc-coll__soon { margin: 0; }

.hc-coll__soon-frame {
  /* Sized for a portrait lifestyle shot: much wider and it dominates the page
     rather than previewing it. */
  max-width: 560px;
  margin: 0 auto;
  border-radius: var(--radius-xl);
  overflow: hidden;
  background: var(--color-bg-alt);
}
.hc-coll__soon-frame img { width: 100%; height: auto; display: block; }

.hc-coll__soon-caption {
  margin-top: var(--space-8);
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* Scoped under .hc-coll__empty: the generic `.hc-coll__empty p` rule is
   specificity (0,1,1) and would otherwise beat a bare class here. */
.hc-coll__empty .hc-coll__soon-label {
  font-family: var(--font-body);
  font-size: var(--text-xs);
  font-weight: 600;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--color-gold);
  margin: 0 0 var(--space-4);
}

.hc-coll__soon-rule { margin-bottom: var(--space-5); }

.hc-coll__empty .hc-coll__soon-text {
  max-width: 460px;
  margin: 0;
  font-size: var(--text-base);
  line-height: 1.7;
  color: var(--color-text-secondary);
}

.sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0,0,0,0); }
</style>

{% schema %}
{
  "name": "Collection",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show collection title",
      "info": "Turn off when the template already provides a heading above this section.",
      "default": true
    },
    {
      "type": "header",
      "content": "Empty collection"
    },
    {
      "type": "image_picker",
      "id": "empty_image",
      "label": "Preview image",
      "info": "Shown instead of the 'no products' message when the collection is empty."
    },
    {
      "type": "text",
      "id": "empty_image_asset",
      "label": "Preview image asset",
      "info": "Filename in assets/, used only when no image is picked above. e.g. merch-coffee-club.jpg"
    },
    {
      "type": "text",
      "id": "empty_alt",
      "label": "Preview image alt text"
    },
    {
      "type": "text",
      "id": "empty_label",
      "label": "Preview label",
      "default": "Coming soon"
    },
    {
      "type": "textarea",
      "id": "empty_text",
      "label": "Preview text"
    }
  ]
}
{% endschema %}
