    "about": {
      "type": "about",
      "settings": {
        "dark_background": false,
        "image": "shopify://shop_images/hc-about-jebena-netela.png",
        "image_2": "shopify://shop_images/hc-about-sini-cardamom.png",
        "badge_number": "3",
        "badge_text": "Rounds to every ceremony",
        "eyebrow": "Our Story",
        "heading": "Buna is not a drink. It is an invitation.",
        "text": "<p>In Ethiopia, coffee is not something you pick up on the way somewhere else. Green beans are roasted over coals while you wait, ground by hand, and brewed in a clay jebena. It is poured three times: <em>abol</em>, <em>tona</em>, <em>baraka</em>. You are expected to stay for all three.</p><p>That is the part we brought to Austin. We roast four Ethiopian origins in small batches, and we tell you exactly where each one came from.</p>",
        "button_label": "Our history",
        "button_link": "shopify://pages/our-history"
      },
      "blocks": {
        "feature-1": {
          "type": "feature",
          "settings": {
            "icon": "leaf",
            "title": "Bought by name",
            "text": "We buy from washing stations and smallholder cooperatives, and every lot stays traceable to the one that produced it."
          }
        },
        "feature-2": {
          "type": "feature",
          "settings": {
            "icon": "globe",
            "title": "Four origins",
            "text": "Yirgacheffe, Harar, Sidama and Guji. One country, four cups that taste nothing alike."
          }
        },
        "feature-3": {
          "type": "feature",
          "settings": {
            "icon": "heart",
            "title": "Roasted here",
            "text": "Small batches roasted in Austin and dated on the bag. Nothing sits on a shelf waiting for you."
          }
        }
      },
      "block_order": ["feature-1", "feature-2", "feature-3"]
    },
    "process": {
      "type": "process",
      "settings": {
        "eyebrow": "How it works",
        "heading": "From the highlands to your cup"
      },
      "blocks": {
        "step-1": {
          "type": "step",
          "settings": {
            "image": "shopify://shop_images/hc-process-source.png",
            "title": "Source",
            "text": "We buy from washing stations in Yirgacheffe, Sidama and Guji, and from the dry mills of the Harar highlands. Grade, altitude and process go on every label."
          }
        },
        "step-2": {
          "type": "step",
          "settings": {
            "image": "shopify://shop_images/hc-process-roast.png",
            "title": "Roast",
            "text": "Small batches, roasted in Austin. Light for the washed lots so the florals survive; a little deeper for the naturals so the fruit fills out."
          }
        },
        "step-3": {
          "type": "step",
          "settings": {
            "image": "shopify://shop_images/hc-process-brew.png",
            "title": "Brew",
            "text": "Ground fresh and brewed in a clay jebena over coals, in the same vessel and very nearly the same method, for six hundred years."
          }
        },
        "step-4": {
          "type": "step",
          "settings": {
            "image": "shopify://shop_images/hc-process-share.png",
            "title": "Share",
            "text": "Poured three times into small sini cups. Abol for the guest, tona for the conversation, baraka for the blessing."
          }
        }
      },
      "block_order": ["step-1", "step-2", "step-3", "step-4"]
    },
